APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pinbot
DB_USERNAME=pinbot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum SPA (comma-separated hosts that serve the React app; include the port in dev) ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# --- Pinterest API v5 (https://developers.pinterest.com/apps/) ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your Pinterest app.
PINTEREST_REDIRECT_URI="${APP_URL}/pinterest/callback"
PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read,ads:read
# trial (1,000 requests/day per app, 300 Pin creations/day) or standard (per-minute limits). PinBot budgets its own requests to stay under them.
PINTEREST_ACCESS_LEVEL=trial
# PINTEREST_API_URL=https://api.pinterest.com/v5
# PINTEREST_SANDBOX_API_URL=https://api-sandbox.pinterest.com/v5

# --- AI text generation (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# openai | gemini | fake (offline, deterministic). Defaults to openai, then gemini, by which key is set.
# PINBOT_AI_PROVIDER=
# openai | gemini | none
# PINBOT_IMAGE_PROVIDER=

# --- Fetching & images ---
PINBOT_FETCH_TIMEOUT=15
PINBOT_FETCH_MAX_HTML_BYTES=3145728
PINBOT_FETCH_MAX_IMAGE_BYTES=15728640
PINBOT_FETCH_USER_AGENT="PinBot/1.0 (+https://your-domain.example/bot)"
PINBOT_MAX_BULK_URLS=500
# TrueType font used for template text overlays (Ubuntu: apt install fonts-dejavu-core)
PINBOT_OVERLAY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- Initial admin created by `php artisan db:seed` ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
